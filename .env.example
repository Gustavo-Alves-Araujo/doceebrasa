# ============================================================
#  DOCE E BRASA · variáveis de ambiente
#  Copie para .env.local (dev) e cadastre na Vercel (produção):
#  Vercel → Project → Settings → Environment Variables
#  Nada aqui vai para o navegador — só as funções em /api leem.
# ============================================================

# ---------- CORREIOS (cálculo de frete) ----------
# Usuário do portal "Meu Correios" (CNPJ ou login do administrador)
CORREIOS_USUARIO=
# Código de acesso gerado em cws.correios.com.br → Gerenciar Acesso à API
CORREIOS_CODIGO_ACESSO=
# Número do cartão de postagem (fica no contrato)
CORREIOS_CARTAO_POSTAGEM=
# Número do contrato (aparece no mesmo lugar)
CORREIOS_CONTRATO=
# Diretoria Regional do contrato — opcional, só se o suporte pedir
CORREIOS_DR=
# CEP de onde os pedidos são postados (só números)
CEP_ORIGEM=38400000
# Serviços consultados: "codigo:Nome" separados por vírgula.
# Com contrato: 03220 = SEDEX, 03298 = PAC.
# Sem contrato: 04014 = SEDEX, 04510 = PAC.
CORREIOS_SERVICOS=03220:SEDEX,03298:PAC
# Trocar para https://apihom.correios.com.br em homologação
CORREIOS_API_BASE=https://api.correios.com.br

# ---------- ASAAS (pagamento) ----------
# Chave gerada em Asaas → Integrações → API
# Sandbox começa com $aact_hmlg_ · Produção com $aact_prod_
ASAAS_API_KEY=
# Opcional: força o ambiente. Detectado pela chave se ficar vazio.
# Sandbox:  https://api-sandbox.asaas.com/v3
# Produção: https://api.asaas.com/v3
ASAAS_API_BASE=
# Token que você inventa e repete no cadastro do webhook no Asaas
ASAAS_WEBHOOK_TOKEN=

# ---------- SITE ----------
# Usado no retorno após o pagamento
SITE_URL=https://docebrasa.com.br
